-- the phases: ask -> go -> build -> leave -> ask ... -> home -> ask (waits for more work)

local function ask()
  -- out of the lanes before standing still
  if pos.y >= st.lanes.e and pos.y < st.lanes.wait then moveY(st.lanes.wait); save() end
  local reply = get(string.format("/next?t=%s&x=%d&y=%d&z=%d", cfg.label, pos.x, pos.y, pos.z))
  if not reply then say("Can't reach the job server; trying again in 30 s."); sleep(30); return end
  local L = lines(reply)
  local head = L[1] or ""
  if head:match("^wait") then
    local secs, why = head:match("^wait (%d+) ?(.*)")
    -- wait above everything (the column I'm in is clear up there: I came down it), out of everyone's way;
    -- on my depot spot I wait right there (between zones everybody waits at home)
    local home = st.home and pos.x == st.home.x and pos.y == st.home.y and pos.z == st.home.z
    if not home and st.lanes.wait < 256 and pos.y < st.lanes.wait then moveY(st.lanes.wait); save() end
    if why ~= lastMsg then tell("Waiting: " .. (why or "")) end
    sleep(tonumber(secs) or 30)
    return
  end
  if head == "none" or head:match("^stop") then
    -- finished (or not part of the build the server has now): stop here for good
    local why = head == "none" and "Nothing left to build and I'm home, so I've stopped." or (head:match("^stop ?(.*)") or "")
    st.phase, st.stopped = "stopped", why .. " Start me again with: cityfleet " .. cfg.slot .. " go"
    save()
    return
  end
  local info = {}
  for i = 2, #L do
    local k, rest = L[i]:match("^(%S+)%s*(.*)$")
    if k then info[k] = rest end
  end
  if not info["end"] and not L[#L]:match("^end") then say("Half an answer from the job server; asking again."); sleep(10); return end
  st.lanes = parseLanes(info.lanes or "")
  local route = parseRoute(info.route or "")
  if head:match("^home") then
    local hx, hy, hz = head:match("^home (%-?%d+) (%-?%d+) (%-?%d+)")
    st.legs = laneLegs(route, {})
    st.legs[#st.legs + 1] = { "v", tonumber(hy) }
    st.leg, st.phase, st.job = 1, "home", nil
    save()
    tell("All my work is done; flying home.")
    return
  end
  local id, kind, blocks, name = head:match("^job (%S+) (%S+) (%d+) (.*)$")
  if not id then say("Odd answer from the job server: " .. head); sleep(30); return end
  local ax, ay, az = info.at:match("^(%-?%d+) (%-?%d+) (%-?%d+)")
  local dx, dz = info.dock:match("^(%-?%d+) (%-?%d+)")
  local ex, ez = info.enter:match("^(%-?%d+) (%-?%d+)")
  -- the build file
  local file = get("/plan/" .. id)
  if not file or not file:match("\nend\n?$") then say("Couldn't download the build file for " .. id .. "; trying again."); sleep(20); return end
  writeFile(PLAN_FILE, file)
  local err
  plan, err = loadPlan()
  if not plan then say("Build file " .. id .. ": " .. err); sleep(30); return end
  -- fuel for the trip, before flying (here, between jobs, there's room for the chest above me)
  if fuelLevel() < TRAVEL_FUEL then st.cell = #plan.xs + 1; restock(nil, TRAVEL_FUEL) end
  st.job = { id = id, kind = kind, name = name, at = { x = tonumber(ax), y = tonumber(ay), z = tonumber(az) },
    dock = { x = tonumber(dx), z = tonumber(dz) }, enter = { x = tonumber(ex), z = tonumber(ez) } }
  st.cell = 1
  st.legs = laneLegs(route, {})
  st.legs[#st.legs + 1] = { "v", plan.ys[1] + 1 }                    -- down (or up) the dock column
  st.legs[#st.legs + 1] = { "h", st.job.enter.x, st.job.enter.z }    -- one step into the job
  st.leg, st.phase = 1, "go"
  save()
  tell(string.format("Job %s: %s, %s blocks. Flying there.", id, name, blocks))
end

local function build()
  local total = #plan.xs
  local lastLayer
  while st.cell <= total do
    local i = st.cell
    if plan.ys[i] ~= lastLayer then
      lastLayer = plan.ys[i]
      say(string.format("%s: layer %d (%d%% done)", st.job.id, lastLayer - plan.ys[1], math.floor((i - 1) * 100 / total)))
      report(true)
    end
    placeCell(i)
    st.cell = i + 1
    save()
    report(false)
    maybeUpdate()
  end
  restock(nil)          -- hand back what's left (and top up fuel)
  -- out the way I came in: inside the job's own area to the column next to the dock, then into it
  st.legs = { { "h", st.job.enter.x, pos.z }, { "h", st.job.enter.x, st.job.enter.z }, { "h", st.job.dock.x, st.job.dock.z } }
  st.leg, st.phase = 1, "leave"
  save()
end

-- The position check (first start, when the server has one). Plain moves only, so nothing is ever
-- dug, and I face north the whole time (back() on the way back), so a restart can't lose a turn.
-- A move whose answer a restart lost is recovered from the fuel, like any other (st.pend).
local function plainMove(back)
  local nz = pos.z + (back and 1 or -1)
  st.pend = { fuel = turtle.getFuelLevel(), x = pos.x, y = pos.y, z = nz }
  save()
  local told = false
  while true do
    local moved
    if back then moved = turtle.back() else moved = turtle.forward() end
    if moved then break end
    if not back and turtle.detect() and peripheral.getType("front") ~= "turtle" then
      st.pend = nil; save()
      return false
    end
    if not told then say("Something is in my way (another turtle or a mob?); waiting."); told = true end
    sleep(1 + math.random())
  end
  pos.z, st.pend = nz, nil
  save()
  return true
end

local function checkPosition()
  local c = st.check
  while not c.steps and not c.found do
    local reply = get(string.format("/check?t=%s&x=%d", cfg.label, pos.x))
    local head = reply and lines(reply)[1] or ""
    if not reply then say("Can't reach the job server for my position check; trying again in 30 s."); sleep(30)
    elseif head == "none" then st.check, st.phase = nil, "ask"; save(); return
    elseif head:match("^check %d+") then c.steps = tonumber(head:match("^check (%d+)")); save()
    else
      local secs, why = head:match("^wait (%d+) ?(.*)")
      if "Waiting: " .. (why or head) ~= lastMsg then tell("Waiting: " .. (why or head)) end
      sleep(tonumber(secs) or 30)
    end
  end
  if not c.found then
    -- (on my spot there's room for the Ender Chest above me)
    if pos.z == st.home.z and fuelLevel() < 2 * c.steps + 20 then restock(nil, TRAVEL_FUEL) end
    say("Checking my position: flying north to the city's edge.")
    while true do
      local n = st.home.z - pos.z
      if n > 0 and turtle.detectDown() then c.found = { e = "down", z = pos.z }; break end
      if n >= c.steps then c.found = { e = "none", z = pos.z }; break end
      if turtle.detect() and peripheral.getType("front") ~= "turtle" then c.found = { e = "front", z = pos.z }; break end
      if not plainMove(false) then c.found = { e = "front", z = pos.z }; break end
    end
    save()
  end
  while not c.verdict do
    local reply = get(string.format("/check?t=%s&x=%d&z=%d&e=%s", cfg.label, pos.x, c.found.z, c.found.e))
    if reply then c.verdict = lines(reply)[1] or "bad (empty answer)"; save()
    else say("Can't reach the job server with my position check; trying again in 30 s."); sleep(30) end
  end
  while pos.z < st.home.z do plainMove(true) end
  if c.verdict == "ok" then
    st.check, st.phase = nil, "ask"
    save()
    tell("Position checked: I'm where I think I am.")
  else
    st.phase = "stopped"
    st.stopped = string.format("I'm not where I think I am: %s Check my depot spot (%d,%d,%d, facing north), then run: cityfleet %d go",
      (c.verdict:gsub("^bad ?", "")), st.home.x, st.home.y, st.home.z, cfg.slot)
    save()
  end
end

local function loop()
  while true do
    if st.phase == "check" then checkPosition()
    elseif st.phase == "stopped" then
      -- stay stopped, but keep checking in: Restart turtles starts me over (see pauseHere)
      tell(st.stopped)
      while true do sleep(60); report(true, st.stopped) end
    elseif st.phase == "ask" then maybeUpdate(); ask()
    elseif st.phase == "go" then
      runLegs()
      st.phase = "build"; save()
    elseif st.phase == "build" then
      if not plan then plan = assert(loadPlan()) end
      build()
    elseif st.phase == "leave" then
      runLegs()
      local name = st.job.name
      while not get("/done?t=" .. cfg.label .. "&job=" .. st.job.id) do say("Can't reach the job server to say I'm done; trying again."); sleep(30) end
      st.phase, st.job, plan = "ask", nil, nil
      if fs.exists(PLAN_FILE) then fs.delete(PLAN_FILE) end
      save()
      tell(name .. " is built.")
    elseif st.phase == "home" then
      runLegs()
      st.phase = "ask"; save()
      turnTo(3)
      tell("Home.")
    else
      error("Unknown phase " .. tostring(st.phase))
    end
  end
end

