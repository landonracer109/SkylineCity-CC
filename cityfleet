-- cityfleet: one of the Skyline City turtles. Asks the city job server for a job, flies there along
-- the lanes, builds it, and asks for the next one, until the city is done; then flies home.
-- ComputerCraft 1.63 turtle with a Narcissistic upgrade (OpenPeripherals Addons, reads the turtle's
-- own inventory) and a diamond pickaxe. Its own Ender Chest in slot 16 (each turtle has its own
-- frequency; the supply computer at home keeps it stocked with what this turtle reports it needs).
--
-- Usage
--   cityfleet <slot> [server]   first start: put me on my depot spot (slot 1-16) facing NORTH
--   cityfleet <slot> [server] go   the same, without waiting for Enter
--   cityfleet                   carries on after a restart (runs from startup by itself)
--   cityfleet status            what I'm doing
--
-- Updates: when the job server announces a new release ("update <version> <commit>" in its answer to
-- a report), I download that commit of cityfleet from GitHub (only from REPO), check it, and restart
-- into it at the next safe spot (just after placing a block, or between jobs).
--
-- I keep track of where I am by counting my own moves (there's no GPS), so I must start exactly on
-- my depot spot facing north, and must never be moved by hand while the program runs. If that
-- happens: pick me up, put me back on my depot spot facing north, and run "cityfleet <slot> go".
-- Position check (v1.11; when the job server has one, e.g. for repairing a pasted city): on a first
-- start I fly north from my depot spot at its height, digging nothing, until I find the city's edge,
-- and the server tells me whether I found it where I should have. Then I fly back to my spot and
-- start work, or, if not, stop there with a message. It catches a spot that is off in y or z (and
-- in x only across a step of the edge), so check each turtle's x with F3 too.
-- With nothing to do (the server says wait) I wait up at the wait height, above everything the
-- build places, straight up from where I finished, so I'm never in another turtle's way (v1.12);
-- on my depot spot I wait right there (v1.15: between zones everybody waits at home).
-- When the whole build is done and I'm home, I stop and wait (v1.13). The server can also tell me to
-- stop ("stop": I wasn't started for the build it has now); reports from a turtle like that are
-- answered "pause".
-- Restart turtles (v1.14, a button on the job server's page): every turtle stops where it is. One
-- that is home starts over by itself; any other switches itself off: pick it up, put it on its depot
-- spot facing north and turn it on. On boot I ask the server (/boot); if a restart is on, I switched
-- myself off for it (or I'm home) and I'm standing on something, I throw away my old state and start
-- fresh from my depot spot, as if "cityfleet <slot> go" had been typed. No commands to type. (A turtle
-- that reboots where it is, say after a Minecraft server restart, never switched itself off, so it
-- carries on from its saved state instead, and gets stopped like the others.)
-- Deploy fleet (v1.16, a button on the job server's page): the deployer turtle (citydeploy) puts
-- turtles on the free depot spots facing north, drops an Ender Chest into each and turns it on, having
-- told the server that turtle's computer id and spot. On boot I send my id; the answer "fresh <slot>"
-- makes me that slot (label city<slot>): I move the chest to slot 16 and start fresh, untyped.
-- Sign gantries (v1.15): a cell line with a 4th number is placed forward (the way to face; I stand
-- one block back at the same height, got to from one above), so the advanced monitors stand upright
-- against the panel behind them. A floppy cell (the spot of the disk drive placed just before) puts a
-- floppy in that drive and writes the sign program (citysign, from the job server) and the sign's text
-- (the "sign" line after it) onto it; an advanced computer is turned on once placed. Computers, drives
-- and monitors already there are never dug.
-- Travelling, I fly at one height per direction (east, west, south, north each have their own lane
-- above the streets) so turtles never meet head on.

local args = { ... }
local VERSION = "v1.16"
local CFG_FILE, STATE_FILE, PLAN_FILE = "cityfleet.cfg", "fleet.state", "fleet.plan"
local DEFAULT_SERVER = "https://brlink.tailbdc4d5.ts.net/city"
local CHEST = 16
local MIN_FUEL = 300
local TRAVEL_FUEL = 2000    -- topped up to this before flying to a new job
local WINDOW = 640          -- each restock loads blocks for this many upcoming placements
local REPORT_EVERY = 60     -- seconds between progress reports (and on every new layer)
local REPO = "https://raw.githubusercontent.com/landonracer109/SkylineCity-CC/"

local function say(msg)
  print(msg)
  local line = string.format("[day %d %s] %s", os.day(), textutils.formatTime(os.time(), true), msg)
  if fs.exists("city.log") and fs.getSize("city.log") > 16000 then
    local h = fs.open("city.log", "r"); local keep = h.readAll():sub(-8000); h.close()
    h = fs.open("city.log", "w"); h.write(keep); h.close()
  end
  local h = fs.open("city.log", "a")
  if h then h.writeLine(line); h.close() end
end

local function readFile(name)
  local h = fs.open(name, "r")
  if not h then return nil end
  local s = h.readAll(); h.close()
  return s
end

local function writeFile(name, s)
  local h = fs.open(name, "w"); h.write(s); h.close()
end

---------------------------------------------------------------------------------------------------
-- state: st = { phase, pos = { x, y, z, f }, home = { x, y, z }, job = { id, kind, name, at, dock,
-- enter }, lanes = { e, w, s, n, wait }, legs, leg, cell, chest, pend }. Everything in world coords.

local cfg, st, pos

local function save() writeFile(STATE_FILE, textutils.serialize(st)) end

local function loadState()
  local s = readFile(STATE_FILE)
  s = s and textutils.unserialize(s)
  if type(s) ~= "table" or not s.pos or not s.phase then return false end
  st, pos = s, s.pos
  return true
end

---------------------------------------------------------------------------------------------------
-- the job server

local function get(path)
  local ok, r = pcall(http.get, cfg.server .. path)
  if not ok or not r then return nil end
  local s = r.readAll(); r.close()
  return s
end

-- Returns the server's answer (nil when it can't be reached).
local function post(path, body)
  local ok, r = pcall(http.post, cfg.server .. path, body)
  if not ok or not r then return nil end
  local s = r.readAll(); r.close()
  return s or ""
end

local function lines(s)
  local t = {}
  for l in (s or ""):gmatch("[^\n]+") do t[#t + 1] = l end
  return t
end

---------------------------------------------------------------------------------------------------
-- the build file (cells converted to world coordinates)

local plan

local function loadPlan()
  local h = fs.open(PLAN_FILE, "r")
  if not h then return nil, "no build file" end
  local p = { mats = {}, xs = {}, ys = {}, zs = {}, ms = {}, fs = {}, sign = {} }
  local y, at = 0, nil
  while true do
    local line = h.readLine()
    if not line then break end
    local a, b, c, f = line:match("^(%-?%d+) (%-?%d+) (%d+) ?([0-3]?)$")
    if a then
      local n = #p.xs + 1
      p.xs[n], p.ys[n], p.zs[n], p.ms[n] = tonumber(a) + at.x, y + at.y, tonumber(b) + at.z, tonumber(c)
      p.fs[n] = tonumber(f)          -- placed forward, facing this way
    else
      local cmd, rest = line:match("^(%S+)%s*(.*)$")
      if cmd == "L" then y = tonumber(rest)
      elseif cmd == "at" then
        local ax, ay, az = rest:match("^(%-?%d+) (%-?%d+) (%-?%d+)")
        at = { x = tonumber(ax), y = tonumber(ay), z = tonumber(az) }
      elseif cmd == "mat" then
        local n, id, dmg, name = rest:match("^(%d+) (%d+) (%d+) (.*)$")
        p.mats[tonumber(n)] = { id = tonumber(id), dmg = tonumber(dmg), name = name }
      elseif cmd == "name" then p.name = rest
      elseif cmd == "sign" then p.sign[#p.xs] = rest
      elseif cmd == "end" then p.complete = true end
    end
  end
  h.close()
  if not p.complete or not at then return nil, "the build file is cut short" end
  return p
end

---------------------------------------------------------------------------------------------------
-- inventory: the Narcissistic upgrade tells us what is in each slot

local self_
local slotMat = {}
local dirty = true

local function findSelf()
  for _, side in ipairs({ "left", "right" }) do
    local methods = peripheral.getMethods(side)
    if methods then
      for _, m in ipairs(methods) do
        if m == "getAllStacks" then return peripheral.wrap(side) end
      end
    end
  end
  return nil
end

local function stacksOf(p)
  local ok, all = pcall(p.getAllStacks)
  if not ok or type(all) ~= "table" then return {} end
  if all[0] == nil then return all end
  local shifted = {}
  for k, v in pairs(all) do shifted[k + 1] = v end
  return shifted
end

local function matOf(stack)
  if type(stack) ~= "table" or not stack.id or not plan then return nil end
  for n, m in pairs(plan.mats) do
    if m.id == stack.id and m.dmg == stack.dmg then return n end
  end
  return nil
end

local function isChest(stack)
  return type(stack) == "table" and st and st.chest and stack.id == st.chest.id and stack.dmg == st.chest.dmg
end

local function rescan()
  local stacks = stacksOf(self_)
  slotMat = {}
  for s = 1, 15 do
    if isChest(stacks[s]) and turtle.getItemCount(CHEST) == 0 then
      turtle.select(s); turtle.transferTo(CHEST)
    else
      slotMat[s] = matOf(stacks[s])
    end
  end
  dirty = false
end

local function slotFor(m)
  if dirty then rescan() end
  for s = 1, 15 do
    if slotMat[s] == m and turtle.getItemCount(s) > 0 then return s end
  end
  return nil
end

local function fuelLevel()
  local f = turtle.getFuelLevel()
  if f == "unlimited" then return math.huge end
  return f
end

---------------------------------------------------------------------------------------------------
-- reporting: where I am, how far the job is, and what my Ender Chest should hold next

local lastReport, lastMsg = -1e9, ""

local function upcoming()
  local need, order = {}, {}
  if not plan or not st.cell then return need, order end
  for i = st.cell, math.min(#plan.xs, st.cell + WINDOW - 1) do
    local m = plan.ms[i]
    if not need[m] then need[m] = 0; order[#order + 1] = m end
    need[m] = need[m] + 1
  end
  return need, order
end

-- Returns the server's answer: "pause" while the Pause button is on (nil if no report was due).
local pausing, pauseHere = false, nil   -- (pauseHere is below)
local restartOffered = false            -- the server's report answer says Restart turtles is on
local updateTo, updateFailed = nil, {}   -- the release the server announced: { v = "v1.11", commit = sha }

-- At a safe spot: if a new release was announced, fetch it, make sure it's whole, and restart into it.
local function maybeUpdate()
  local u = updateTo
  if not u or u.v == VERSION or (updateFailed[u.commit] and os.clock() - updateFailed[u.commit] < 600) then return end
  say("Updating to cityfleet " .. u.v .. "...")
  local ok, r = pcall(http.get, REPO .. u.commit .. "/cityfleet")
  local code = ok and r and r.readAll()
  if r then r.close() end
  if not code or not code:find('local VERSION = "' .. u.v .. '"', 1, true) or not loadstring(code) then
    say("The download didn't work; carrying on with " .. VERSION .. " (I'll try again in 10 minutes).")
    updateFailed[u.commit] = os.clock()
    return
  end
  save()
  local h = fs.open("cityfleet.new", "w"); h.write(code); h.close()
  if fs.exists("cityfleet") then fs.delete("cityfleet") end
  fs.move("cityfleet.new", "cityfleet")
  say("Updated to " .. u.v .. ". Restarting.")
  sleep(1)
  os.reboot()
end

-- Sends where I am and what I need next. Any answer of "pause" (the Pause button) stops me right
-- here until Resume, whatever sent the report, so every report checks it (a report at the start of
-- each new floor used to reset the once-a-minute one and skip the check).
local function report(force, msg)
  if msg then lastMsg = msg end
  if not force and os.clock() - lastReport < REPORT_EVERY then return nil end
  lastReport = os.clock()
  local need = {}
  if st.phase == "build" or st.phase == "go" then
    local n = upcoming()
    for m, k in pairs(n) do need[#need + 1] = plan.mats[m].id .. ":" .. plan.mats[m].dmg .. "=" .. k end
  end
  local reply = post("/report?t=" .. cfg.label, table.concat({
    "phase " .. st.phase, "job " .. (st.job and st.job.id or "-"), "cell " .. (st.cell or 0),
    "total " .. (plan and #plan.xs or 0), "x " .. pos.x, "y " .. pos.y, "z " .. pos.z,
    "fuel " .. tostring(turtle.getFuelLevel()), "version " .. VERSION, "chest " .. (st.chest and (st.chest.id .. ":" .. st.chest.dmg) or "-"), "msg " .. lastMsg,
    "need " .. table.concat(need, " ") }, "\n"))
  local answer = reply and reply:match("^(%a+)")
  local v, commit = (reply or ""):match("\nupdate (v[%d%.]+) (%x+)")
  if v and #commit == 40 then updateTo = { v = v, commit = commit } end
  if reply then restartOffered = reply:find("\nrestart", 1, true) ~= nil end
  if answer == "pause" and not pausing then pauseHere(); answer = "ok" end
  return answer
end

local function tell(msg) say(msg); report(true, msg) end

-- The Pause button: stay right here (state saved) until the server says carry on. Reports are only
-- sent between moves and placements, so nothing is half done. A server that can't be reached doesn't
-- pause anyone.
pauseHere = function()
  pausing = true
  save()
  say("Paused. Waiting for Resume...")
  report(true, "Paused")
  repeat
    -- Restart turtles: at home I start over (the boot check does it); anywhere else I switch myself
    -- off, to be picked up, put on my depot spot and turned on
    if restartOffered then
      local home = pos.x == st.home.x and pos.y == st.home.y and pos.z == st.home.z
      if not home then st.off = true end
      save()
      report(true, home and "Restart: I'm home, so I'm starting over." or "Restart: switched off. Put me on my depot spot facing north and turn me on.")
      say(home and "Restart: I'm home, so I'm starting over." or
        string.format("Restart: pick me up, put me on my depot spot (%d,%d,%d) facing north and turn me on.", st.home.x, st.home.y, st.home.z))
      sleep(2)
      if home then os.reboot() else os.shutdown() end
    end
    sleep(15)
  until report(true, "Paused") ~= "pause"
  pausing = false
  tell("Resumed.")
end

---------------------------------------------------------------------------------------------------
-- the Ender Chest

-- The Ender Chest goes above me, except at the top of the world (y 255), where there is no room
-- above: then it goes in front (the air up there is empty) and items move through its side.
local WORLD_TOP = 255
local chestAt = "top"
local TOWARD_ME = { [0] = "west", "north", "east", "south" }   -- chest in front of me (facing f) -> me
local function chestDir() return chestAt == "top" and "down" or TOWARD_ME[pos.f] end
local function dropToChest() if chestAt == "top" then return turtle.dropUp() end; return turtle.drop() end

local function readChest(side)
  for _ = 1, 20 do
    local p = peripheral.wrap(side)
    if p and p.getAllStacks then return p end
    sleep(0.1)
  end
  return nil
end

local turnTo   -- (defined with the moving code below)
local function placeChest()
  -- after a restart in the middle of restocking the chest is still out
  if turtle.getItemCount(CHEST) == 0 then
    for _, side in ipairs({ "top", "front" }) do
      local p = peripheral.wrap(side)
      if p and p.getAllStacks then chestAt = side; return p end
    end
  end
  turtle.select(CHEST)
  if pos.y >= WORLD_TOP then
    chestAt = "front"
    for tries = 1, 400 do
      if turtle.place() then
        local p = readChest("front")
        if p then return p end
        error("The Ender Chest in front of me can't be read. Is OpenPeripherals installed?")
      end
      if turtle.detect() and peripheral.getType("front") ~= "turtle" then
        turtle.dig(); dirty = true
      elseif turtle.getItemCount(CHEST) == 0 then
        tell("Put my Ender Chest back in slot 16."); sleep(5)
      else
        turnTo((pos.f + 1) % 4)          -- another turtle there: try the next side
        if tries % 4 == 0 then sleep(2) end
      end
      turtle.select(CHEST)
    end
    error("No room round me for the Ender Chest at the top of the world.")
  end
  chestAt = "top"
  while not turtle.placeUp() do
    if turtle.detectUp() and peripheral.getType("top") ~= "turtle" then
      turtle.digUp(); dirty = true
    else
      tell(turtle.getItemCount(CHEST) == 0 and "Put my Ender Chest back in slot 16." or "Waiting for room above me for the Ender Chest...")
      sleep(5)
    end
    turtle.select(CHEST)
  end
  local p = readChest("top")
  if p then return p end
  error("The Ender Chest above me can't be read. Is OpenPeripherals installed?")
end

local function pickUpChest()
  turtle.select(CHEST)
  if chestAt == "front" then turtle.dig() else turtle.digUp() end
  chestAt = "top"
  turtle.select(1)
  dirty = true
end

local function freeSlot()
  for s = 1, 15 do if turtle.getItemCount(s) == 0 then return s end end
  return nil
end

-- Only these are burned: anything else in the chest (oak logs for a park, planks...) is somebody's
-- building block, even when it isn't one of mine.
local FUEL = { ["173:0"] = true, ["263:0"] = true, ["263:1"] = true }   -- coal block, coal, charcoal

local function refuelFrom(chest, upTo)
  save()   -- (see restock)
  local limit = turtle.getFuelLimit and turtle.getFuelLimit() or 20000
  upTo = math.min(upTo or limit - 1000, limit - 1000)
  local notFuel = {}
  for _ = 1, 30 do
    if fuelLevel() >= upTo then return end
    local slot = freeSlot()
    if not slot then return end
    local found = false
    for cs, stack in pairs(stacksOf(chest)) do
      local key = type(stack) == "table" and stack.id and (stack.id .. ":" .. stack.dmg)
      if key and FUEL[key] and not notFuel[key] then
        found = true
        chest.pushItem(chestDir(), cs, 64, slot)
        turtle.select(slot)
        if turtle.refuel(0) then
          local before = fuelLevel()
          turtle.refuel(1)
          local each = math.max(1, fuelLevel() - before)
          while turtle.getItemCount(slot) > 0 and fuelLevel() < upTo and fuelLevel() + each <= limit do
            if not turtle.refuel(1) then break end
          end
        else
          notFuel[key] = true
        end
        if turtle.getItemCount(slot) > 0 then dropToChest() end
        break
      end
    end
    if not found then return end
  end
end

-- Swaps the inventory over to what the next WINDOW placements need (nothing, between jobs), waiting
-- while the block the next placement needs (`want`) or fuel is missing from the chest.
local restock   -- (below the moving code: restockHere, with room for the chest made first)
local function restockHere(want, fuelWanted)
  fuelWanted = fuelWanted or MIN_FUEL
  -- Save first: the position after my last move may not be saved yet, and refuelling here would
  -- break the fuel check that recovers a move lost in a restart (fuel one less = I moved).
  save()
  say(string.format("Restocking at block %d (fuel %s)", st.cell or 0, tostring(turtle.getFuelLevel())))
  local chest = placeChest()
  local waited = false
  while true do
    local need, order = upcoming()
    local slots, used = {}, 0
    for _, m in ipairs(order) do
      local k = math.min(math.ceil(need[m] / 64), 15 - used)
      if k <= 0 then break end
      slots[m], used = k, used + k
    end
    rescan()
    local keep = {}
    for s = 1, 15 do
      local m, n = slotMat[s], turtle.getItemCount(s)
      if n > 0 then
        if m and slots[m] and (keep[m] or 0) < slots[m] then
          keep[m] = (keep[m] or 0) + 1
        else
          turtle.select(s)
          dropToChest()
          if turtle.getItemCount(s) > 0 then say("My Ender Chest is full; can't hand back slot " .. s .. ".") end
        end
      end
    end
    rescan()
    local stacks = stacksOf(chest)
    for _, m in ipairs(order) do
      if slots[m] then
        local target = math.min(need[m], slots[m] * 64)
        local have = 0
        for s = 1, 15 do if slotMat[s] == m then have = have + turtle.getItemCount(s) end end
        for cs, stack in pairs(stacks) do
          if have >= target then break end
          if matOf(stack) == m and (stack.qty or 0) > 0 then
            for s = 1, 15 do
              if have >= target or (stack.qty or 0) <= 0 then break end
              local cnt = turtle.getItemCount(s)
              if (slotMat[s] == m and cnt < 64) or cnt == 0 then
                local moved = chest.pushItem(chestDir(), cs, math.min(64 - cnt, target - have, stack.qty), s) or 0
                if moved > 0 then slotMat[s] = m end
                have, stack.qty = have + moved, stack.qty - moved
              end
            end
          end
        end
      end
    end
    if fuelLevel() < math.max(MIN_FUEL * 10, fuelWanted) then refuelFrom(chest, math.max(MIN_FUEL * 10, fuelWanted)) end
    rescan()
    if (not want or slotFor(want)) and fuelLevel() >= fuelWanted then break end
    tell("My Ender Chest needs " .. (want and not slotFor(want) and plan.mats[want].name or "fuel (coal)") .. ". Waiting...")
    report(true)
    waited = true
    sleep(10)
  end
  pickUpChest()
  if waited then tell("Got what I needed from my Ender Chest; carrying on.") end
end

---------------------------------------------------------------------------------------------------
-- moving (x east, z south; facing 0 = east, 1 = south, 2 = west, 3 = north)

local DX = { [0] = 1, 0, -1, 0 }
local DZ = { [0] = 0, 1, 0, -1 }
local SIDE = { forward = "front", up = "top", down = "bottom" }
local mayDig = true      -- false on the lanes: nothing should be there, so ask instead of digging

function turnTo(f)   -- (the local declared above placeChest)
  while pos.f ~= f do
    if (pos.f + 1) % 4 == f then turtle.turnRight(); pos.f = f
    else turtle.turnLeft(); pos.f = (pos.f + 3) % 4 end
    save()
  end
end

local function step(dir)
  if fuelLevel() < MIN_FUEL then restock(nil) end
  local move, detect, dig, attack = turtle.forward, turtle.detect, turtle.dig, turtle.attack
  if dir == "up" then move, detect, dig, attack = turtle.up, turtle.detectUp, turtle.digUp, turtle.attackUp
  elseif dir == "down" then move, detect, dig, attack = turtle.down, turtle.detectDown, turtle.digDown, turtle.attackDown end
  local nx, ny, nz = pos.x, pos.y, pos.z
  if dir == "up" then ny = ny + 1 elseif dir == "down" then ny = ny - 1 else nx, nz = nx + DX[pos.f], nz + DZ[pos.f] end
  -- If the server stops right after a move, the move happened but I never heard back. The fuel
  -- level tells: one less than before means I moved (see the start of the program).
  st.pend = { fuel = turtle.getFuelLevel(), x = nx, y = ny, z = nz }
  save()
  local told, since = false, os.clock()
  while not move() do
    if detect() then
      if peripheral.getType(SIDE[dir]) == "turtle" then
        if not told then say("Another turtle is in my way; waiting for it."); told = true end
        sleep(1 + math.random())
      elseif not mayDig or (dir == "down" and st.phase == "build") then
        -- On the lanes nothing should be there, and while building, going down only ever happens
        -- onto my own next layer: ask instead of digging. Coming down a dock column into a job
        -- (empty in the plan) a plant or other junk is dug out like anything else.
        tell(string.format("Something is in my way at %d,%d,%d; please clear it.", nx, ny, nz))
        sleep(10)
      elseif dir == "up" and turtle.getItemCount(CHEST) == 0 and peripheral.wrap("top") and peripheral.wrap("top").getAllStacks then
        pickUpChest()
      else
        dig(); dirty = true
      end
    elseif not attack() then
      sleep(0.5)
    end
    st.pend.fuel = turtle.getFuelLevel()   -- a restock while waiting changes the fuel
  end
  pos.x, pos.y, pos.z = nx, ny, nz
  st.pend = nil
  report(false)     -- a report is due every minute; its answer may be "pause"
end

local function moveX(x) if pos.x ~= x then turnTo(x > pos.x and 0 or 2) end; while pos.x ~= x do step("forward") end end
local function moveZ(z) if pos.z ~= z then turnTo(z > pos.z and 1 or 3) end; while pos.z ~= z do step("forward") end end
local function moveY(y) while pos.y < y do step("up") end; while pos.y > y do step("down") end end

-- The chest goes above me, and Minecraft won't place anything solid at y 255, the top layer of the
-- world. So from y 254 up I first go down to 253 - out of a job by way of its dock column, which is
-- empty all the way down - restock there, and come back.
local relocating = false
restock = function(want, fuelWanted)
  if pos.y <= 253 or relocating then return restockHere(want, fuelWanted) end
  relocating = true
  local back = { x = pos.x, y = pos.y, z = pos.z }
  local inJob = st.job ~= nil and st.phase == "build"
  say("No room for my Ender Chest up here; going down to 253 to restock.")
  if inJob then
    moveX(st.job.enter.x); moveZ(st.job.enter.z)     -- across my own top floor (nothing above it)
    moveX(st.job.dock.x); moveZ(st.job.dock.z)       -- out to the dock column
  end
  moveY(253)
  restockHere(want, fuelWanted)
  if inJob then
    moveY(back.y)
    moveX(st.job.enter.x); moveZ(st.job.enter.z)
    moveX(back.x); moveZ(back.z)
  end
  relocating = false
end

local function goTo(x, y, z)
  if pos.y < y then moveY(y) end
  moveX(x); moveZ(z)
  if pos.y > y then moveY(y) end
end

-- Legs: a list of moves saved with the state, so a restart carries on with the one it was on.
--   { "v", y }        straight up or down
--   { "h", x, z }     along x, then along z, at the height I'm at
-- `lane = true` on a leg means it is flown on the lanes (no digging).
local function runLegs()
  while st.leg <= #st.legs do
    local l = st.legs[st.leg]
    mayDig = not l.lane
    if l[1] == "v" then moveY(l[2]) else moveX(l[2]); moveZ(l[3]) end
    mayDig = true
    st.leg = st.leg + 1
    save()
  end
end

-- Legs along the server's route (corner columns, world x,z), each run at its direction's lane.
local function laneLegs(route, legs)
  local x, z = pos.x, pos.z
  for _, c in ipairs(route) do
    local h
    if c.x > x then h = st.lanes.e elseif c.x < x then h = st.lanes.w
    elseif c.z > z then h = st.lanes.s else h = st.lanes.n end
    legs[#legs + 1] = { "v", h, lane = true }
    legs[#legs + 1] = { "h", c.x, c.z, lane = true }
    x, z = c.x, c.z
  end
  return legs
end

local function parseRoute(rest)
  local route = {}
  for x, z in rest:gmatch("(%-?%d+),(%-?%d+)") do route[#route + 1] = { x = tonumber(x), z = tonumber(z) } end
  return route
end

local function parseLanes(rest)
  local e, w, s, n, wt = rest:match("^(%-?%d+) (%-?%d+) (%-?%d+) (%-?%d+) (%-?%d+)")
  return { e = tonumber(e), w = tonumber(w), s = tonumber(s), n = tonumber(n), wait = tonumber(wt) }
end

