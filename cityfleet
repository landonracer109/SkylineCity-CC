-- placing

-- Blocks a Magnum Torch can't stand on (not solid on top in 1.6.4): glass, glowstone, bars,
-- redstone and yellorium blocks, leaves, and another torch.
local NOT_SOLID = { ["4095:0"] = true, ["20:0"] = true, ["89:0"] = true, ["101:0"] = true, ["152:0"] = true,
  ["1763:0"] = true, ["18:0"] = true, ["2522:0"] = true }
local MAGNUM = "2522:0"

-- A solid building block I'm carrying (one of this job's), for propping up a torch.
local function solidSlot()
  if dirty then rescan() end
  for s = 1, 15 do
    local m = slotMat[s]
    if m and turtle.getItemCount(s) > 0 and not NOT_SOLID[plan.mats[m].id .. ":" .. plan.mats[m].dmg] then return s end
  end
  return nil
end

-- A Magnum Torch only goes on a block that's solid on top. A few torch spots in the plan stand on
-- glowstone, or on another torch over air; there I step down into the torch's spot, put a solid
-- block of my own under it, and step back up. Returns true when it did.
local function propUpTorch(x, y, z)
  local s = solidSlot()
  if not s then return false end
  say(string.format("The torch at %d,%d,%d has nothing solid under it; putting a block there.", x, y, z))
  step("down")                          -- into the torch's spot (empty: the torch didn't place)
  if turtle.detectDown() then turtle.digDown(); dirty = true end
  s = solidSlot()
  local ok = false
  if s then turtle.select(s); ok = turtle.placeDown() end
  step("up")
  return ok
end

-- Sign gantry parts: what peripheral.getType says when one is already there (never dug: a drive
-- would throw its floppy out), and the floppy that goes in the drive.
local PERIPH = { ["765:4"] = "monitor", ["765:0"] = "drive", ["764:16384"] = "computer" }
local FLOPPY = 5883

-- the sign program, from the job server (kept, in case the server can't be reached next time)
local function signProgram()
  for _ = 1, 30 do
    local code = get("/sign")
    if code and code:match("^%-%- citysign") and loadstring(code) then writeFile("citysign", code); return code end
    code = readFile("citysign")
    if code then return code end
    say("Can't get the sign program from the job server; trying again in 20 s.")
    sleep(20)
  end
  error("No sign program (the job server's /sign).")
end

-- the floppy for the drive below the spot: put it in (unless one is there) and write the sign onto it
local function loadSign(i)
  local x, y, z, m = plan.xs[i], plan.ys[i], plan.zs[i], plan.ms[i]
  goTo(x, y + 1, z)
  if peripheral.getType("bottom") ~= "drive" then error(string.format("No disk drive at %d,%d,%d for the sign's floppy.", x, y, z)) end
  for _ = 1, 100 do
    if disk.isPresent("bottom") then break end
    local s = slotFor(m)
    if not s then restock(m)
    else
      turtle.select(s)
      if turtle.dropDown() then dirty = true else sleep(0.5) end
    end
  end
  local mp
  for _ = 1, 20 do
    mp = disk.isPresent("bottom") and disk.getMountPath("bottom")
    if mp then break end
    sleep(0.5)
  end
  if not mp then error(string.format("Can't read the floppy in the disk drive at %d,%d,%d.", x, y, z)) end
  writeFile(mp .. "/startup", signProgram())
  writeFile(mp .. "/sign.txt", (plan.sign[i] or ""):gsub("|", "\n") .. "\n")
end

local function placeCell(i)
  local x, y, z, m = plan.xs[i], plan.ys[i], plan.zs[i], plan.ms[i]
  if plan.mats[m].id == FLOPPY then return loadSign(i) end
  local f = plan.fs[i]
  local detect, compare, place, dig, attack, side = turtle.detectDown, turtle.compareDown, turtle.placeDown, turtle.digDown, turtle.attackDown, "bottom"
  if f then
    -- forward: one block back from the spot, from one above (this layer is built, the one above isn't)
    goTo(x - DX[f], y + 1, z - DZ[f])
    moveY(y)
    turnTo(f)
    detect, compare, place, dig, attack, side = turtle.detect, turtle.compare, turtle.place, turtle.dig, turtle.attack, "front"
  else
    goTo(x, y + 1, z)
  end
  local key = plan.mats[m].id .. ":" .. plan.mats[m].dmg
  local torch, periph = key == MAGNUM, PERIPH[key]
  local function done()
    if periph == "computer" then pcall(peripheral.call, side, "turnOn") end
  end
  local fails, propped = 0, false
  for _ = 1, 200 do
    if periph and peripheral.getType(side) == periph then return done() end
    local s = slotFor(m)
    if not s then
      restock(m)
    else
      turtle.select(s)
      if detect() then
        if compare() then return done() end
        local there = peripheral.getType(side)
        if there == "turtle" then sleep(1)
        elseif there then error(string.format("A %s is where the %s goes at %d,%d,%d; I won't dig it.", there, plan.mats[m].name, x, y, z))
        else dig(); dirty = true end
      elseif place() then
        return done()
      else
        fails = fails + 1
        if torch and fails >= 3 and not propped then
          propped = true
          if not propUpTorch(x, y, z) then say("No solid block to put under the torch; I need one of this job's blocks.") end
        else
          attack(); sleep(0.5)
        end
      end
    end
  end
  error(string.format("Couldn't place %s at %d,%d,%d.", plan.mats[m].name, x, y, z))
end

